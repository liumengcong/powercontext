# 复制为 .env 后按需修改；不写任何密钥，本应用不需要模型 API。
# backend/config.py 读取本文件，且不会覆盖真实环境变量。

# 数据目录：PowerContext SQLite、调度器文件、导入去重映射、验证记录都放在这里
STUDYFLOW_DATA_DIR=./data

# PowerContext builtin runtime 的持久化数据库（默认 $STUDYFLOW_DATA_DIR/powercontext.db）
STUDYFLOW_DB_PATH=./data/powercontext.db

# 只监听本机回环地址；初版是本地单用户工具，不对外提供多用户服务
STUDYFLOW_HOST=127.0.0.1
STUDYFLOW_PORT=8712

# 首次启动时的工作区名。工作区→scope 的映射由 PowerContext 保存，scope 只是数据选取边界，不是认证
STUDYFLOW_WORKSPACE=个人学习

# 演示数据文件
STUDYFLOW_SAMPLE_DATA=./sample-data.json

# 故障演练端点（/api/dev/disconnect、/api/dev/reconnect）。
# 只有设为 1 才注册；生产使用请留空，界面在断开时也不会假装成功。
# STUDYFLOW_ALLOW_DESTRUCTIVE_DEV=1
