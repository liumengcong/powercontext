{
  "name": "stepfun-edge-seekdb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "models": "node scripts/prepare-model.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/integration.ts",
    "report": "node scripts/summarize.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "seekdb": "1.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "22.18.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
