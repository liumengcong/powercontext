# Defaults to real embedded seekdb; native binaries download from OceanBase on first use.
SEEKDB_MODE=embedded
SEEKDB_PATH=./runtime/seekdb
SEEKDB_DATABASE=stepfun
HOST=127.0.0.1
PORT=3000
# For an existing server, set SEEKDB_MODE=server and these parameters:
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
