      "revision": "v1",
      "file_sha256": "9127dc28f271dc9516278fa20028fd6e29a37d4e0460b431a4da36267d7ee317",
      "content": "保留输入顺序；不修改输入列表或字典；每个返回项是独立浅拷贝；空输入返回空列表。",
      "keywords": "orders list_orders regression"
    },
    {
      "source_id": "business/orders.py::list_orders",
      "kind": "code",
      "path": "business/orders.py",
      "symbol": "list_orders",
      "start_line": 1,
      "end_line": 15,
      "revision": "sha256",
      "file_sha256": "a7eb061e803bd2a3fa6d087c24b49d1186db620636e96df46e716dc0efdc3cd8",
      "content": "def list_orders(orders, *, status=None, min_total=None):\n    if status is not None and status not in {\"pending\", \"paid\", \"cancelled\"}:\n        raise ValueError(\"invalid status\")\n    if min_total is not None and (\n        isinstance(min_total, bool)\n        or not isinstance(min_total, int)\n        or min_total < 0\n    ):\n        raise ValueError(\"invalid min_total\")\n    return [\n        dict(order)\n        for order in orders\n        if (status is None or order[\"status\"] == status)\n        and (min_total is None or order[\"total\"] >= min_total)\n    ]",
      "keywords": "business/orders.py list_orders "
    },
