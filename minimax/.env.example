# 从官方 MiniMax 控制台获取；不得提交真实密钥。
MINIMAX_API_KEY=
# 中国站 API；国际站用户按自己的账号填写官方端点。
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
# 留空使用 pylibseekdb 启动真实本地 seekdb。
# 也可接已有 seekdb / OceanBase MySQL 模式实例。
SEEKDB_HOST=
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=test
